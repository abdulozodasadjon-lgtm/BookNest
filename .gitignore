#------------------------------------------------------------------------------
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Roslyn / analyzers
.sonarqube/
.sonarlint/
*.ruleset.user

#------------------------------------------------------------------------------
# NuGet
#------------------------------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
.nuget/
# Uncomment if you want to ignore lock files:
# packages.lock.json

#------------------------------------------------------------------------------
# Tests & coverage
#------------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
**/coverage/
**/TestResults/
.coverage/
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.cover
*.gcov
.cr/

#------------------------------------------------------------------------------
# Secrets & local configuration (NEVER commit these)
#------------------------------------------------------------------------------
# .NET User Secrets (normally stored outside repo, but just in case)
secrets.json
**/secrets.json

# Environment files
.env
.env.*
!.env.example
!.env.sample

# Local appsettings overrides
appsettings.Local.json
appsettings.*.Local.json
appsettings.Development.local.json
appsettings.Secrets.json

# Certificates and keys
*.pfx
*.p12
*.pem
*.key
*.snk
*.cer
*.crt
*.publishsettings

# Azure / cloud
azds.yaml
.azure/
*.azurePubxml

#------------------------------------------------------------------------------
# Local databases (SQLite, LocalDB, etc.) and EF Core
#------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf
*.bak
App_Data/
# NOTE: do NOT ignore the EF "Migrations" folder - migrations belong in source control.

#------------------------------------------------------------------------------
# Application runtime files
#------------------------------------------------------------------------------
# Serilog / NLog / log4net file sinks
logs/
**/logs/*.txt
**/logs/*.json
*.log.*

# File uploads / temp data generated at runtime
wwwroot/uploads/
**/wwwroot/uploads/
uploads/
temp/
tmp/

# ASP.NET Core data protection keys
DataProtection-Keys/

# Static web assets build artifacts
node_modules/
npm-debug.log*

